    \"<span class=sf-dump-key>id</span>\" => <span class=sf-dump-num>1</span>
    \"<span class=sf-dump-key>image</span>\" => \"<span class=sf-dump-str title=\"30 characters\">uploads/welcome/1763222592.jpg</span>\"
    \"<span class=sf-dump-key>subtitle</span>\" => \"<span class=sf-dump-str title=\"23 characters\">Sambutan Kepala Sekolah</span>\"
    \"<span class=sf-dump-key>title</span>\" => \"<span class=sf-dump-str title=\"48 characters\">Menyambut Tahun Ajaran Baru dengan Semangat Baru</span>\"
    \"<span class=sf-dump-key>text1</span>\" => \"<span class=sf-dump-str title=\"310 characters\">Selamat datang di website resmi sekolah kamiSmpn 12 Gresik. Dengan penuh rasa syukur, kami memulai tahun ajaran baru dengan harapan dapat terus meningkatkan kualitas pendidikan, membentuk karakter peserta didik, serta menciptakan lingkungan belajar yang aman, nyaman, dan inspiratif bagi seluruh warga sekolah.</span>\"
    \"<span class=sf-dump-key>text2</span>\" => \"<span class=sf-dump-str title=\"232 characters\">Kami percaya bahwa setiap anak memiliki potensi besar yang perlu diarahkan dan dikembangkan. Melalui kerja sama antara guru, orang tua, dan peserta didik, kami berkomitmen untuk menghadirkan pendidikan yang unggul dan berkelanjutan.</span>\"
    \"<span class=sf-dump-key>name</span>\" => \"<span class=sf-dump-str title=\"17 characters\">Drs. Donal Trauma</span>\"
    \"<span class=sf-dump-key>position</span>\" => \"<span class=sf-dump-str title=\"34 characters\">Kepala Sekolah SMPN 12 Washingtown</span>\"
    \"<span class=sf-dump-key>created_at</span>\" => \"<span class=sf-dump-str title=\"19 characters\">2025-11-15 16:03:12</span>\"
