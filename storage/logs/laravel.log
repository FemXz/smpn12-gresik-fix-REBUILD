    \"<span class=sf-dump-key>text1</span>\" => \"\"\"
      <span class=sf-dump-str title=\"176 characters\">Assalamualaikum warahmatullahi wabarakatuh.<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
      <span class=sf-dump-str title=\"176 characters\">Puji syukur kita panjatkan ke hadirat Tuhan Yang Maha Esa karena atas rahmat-Nya, kita dapat melaksanakan kegiatan ini dengan baik.</span>
      \"\"\"
    \"<span class=sf-dump-key>text2</span>\" => \"<span class=sf-dump-str title=\"199 characters\">Saya mengucapkan terima kasih kepada seluruh pihak yang telah mendukung proses belajar mengajar di sekolah ini. Semoga kerja sama yang baik ini terus terjalin demi kemajuan pendidikan di sekolah kita</span>\"
